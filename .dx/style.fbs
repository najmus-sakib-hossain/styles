namespace StyleSchema;

table Style {
  name: string (key, required);
  css: string (required);
}

table Generator {
  prefix: string (key, required);
  property: string (required);
  multiplier: float;
  unit: string (required);
}

table Dynamic {
  key: string (key, required);
  property: string (required);
  values: [DynamicValue];
}

table DynamicValue {
    suffix: string (key, required);
    value: string (required);
}

table Screen {
    name: string (key, required);
    value: string (required);
}

table State {
    name: string (key, required);
    value: string (required);
}

table ContainerQuery {
    name: string (key, required);
    value: string (required);
}

table Color {
  name: string (key, required);
  value: string (required);
}

table AnimationGenerator {
  name: string (key, required);
  template: string (required);
}

// Custom CSS Property metadata used to generate @property at-rules
table Property {
  name: string (key, required);
  syntax: string;            // e.g. "<color>", "*", "<length-percentage>" etc.
  inherits: bool;            // whether the custom property inherits
  initial: string;           // optional initial value (may be empty string if omitted)
}

table Config {
  styles: [Style];
  generators: [Generator];
  dynamics: [Dynamic];
  screens: [Screen];
  states: [State];
  container_queries: [ContainerQuery];
  colors: [Color];
  animation_generators: [AnimationGenerator];
  properties: [Property];
  // Raw base layer CSS snippet (without @layer wrapper or with; runtime will wrap if needed)
  base_css: string;
}

root_type Config;
